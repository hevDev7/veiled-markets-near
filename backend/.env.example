# Copy to backend/.env (gitignored). The turbo oracle loads it at startup; variables already set in the
# environment take precedence.

# Pyth Hermes API key from https://app.pyth.com/account/api-keys. Without it the oracle prices rounds with CoinGecko.
PYTH_API_KEY=

# Comma-separated, tried in order when an endpoint times out or rate-limits.
# NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org

# AI drafting and review on the create page, served by the AI resolver (npm run ai-resolver), which also loads this
# file. An Anthropic API key from https://platform.claude.com; without it /draft and /review answer 503 and the page
# offers templates and its own form only.
# MARKET_AI_API_KEY=
# MARKET_AI_MODEL=claude-opus-5-5

# The AI resolver's market → transaction index (GET /market-tx), built from FastNEAR's Transactions API. A FastNEAR key
# (https://dashboard.fastnear.com) is optional: FastNEAR rate-limits keyless clients harder.
# FASTNEAR_API_KEY=
# MARKET_INDEX_SECONDS=15

# Read resolution sources inside OutLayer's TEE (backend/README.md, "Reading sources in OutLayer"). Set both to turn it
# on; once either is set, the resolver never reads sources itself.
# OUTLAYER_PROJECT=<owner>/veiled-source-reader
# OUTLAYER_PAYMENT_KEY=
# OUTLAYER_API=https://testnet-api.outlayer.ai
# OUTLAYER_VERSION=
# OUTLAYER_COMPUTE_LIMIT=

# Turbo rounds priced by the oracle contract the Veiled owner named (set_turbo_oracle): the keeper stores a Pyth
# Hermes update on it whenever the stored price is too old. Testnet Hermes is hermes-beta, which needs PYTH_API_KEY.
# TURBO_PRICES=contract
# TURBO_PYTH_PUSH_HERMES=https://hermes-beta.pyth.network

# The relayer (npm run relayer) does not load this file: set these in its environment.
# Gasless stablecoin deposits (POST /meta). The relayer pays each one's gas (about 0.01 NEAR); off by default.
# RELAYER_META=1
# RELAYER_META_PER_SENDER=3
# Cross-chain USDC through 1Click (/oneclick/*), mainnet only: off for a .testnet contract whatever this says. A
# partner key (JWT from https://partners.near-intents.org) lowers 1Click's fee. A real quote registers the NEAR
# accounts it needs on USDC (about 0.00125 NEAR each) within the hourly budget.
# ONECLICK_ENABLED=1
# ONECLICK_API_KEY=
# ONECLICK_URL=https://1click.chaindefuser.com
# ONECLICK_NEAR_USDC=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# ONECLICK_QUOTE_LOG=oneclick-quotes.jsonl
# ONECLICK_REGISTER_PER_HOUR=30
