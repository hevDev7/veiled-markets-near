# Copy to backend/.env (gitignored). The turbo oracle loads it at startup; variables already set in the
# environment take precedence.

# Pyth Hermes API key from https://app.pyth.com/account/api-keys. Without it the oracle prices rounds with CoinGecko.
PYTH_API_KEY=

# Comma-separated, tried in order when an endpoint times out or rate-limits.
# NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org

# AI drafting and review on the create page, served by the AI resolver (npm run ai-resolver), which also loads this
# file. An Anthropic API key from https://platform.claude.com; without it /draft and /review answer 503 and the page
# offers templates and its own form only.
# MARKET_AI_API_KEY=
# MARKET_AI_MODEL=claude-opus-5-5
